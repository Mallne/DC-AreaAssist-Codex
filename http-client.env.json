{
  "dev": {
    "server": "http://localhost:8080",
    "Security": {
      Auth: {
        "keycloak": {
          "Type": "OAuth2",
          "Grant Type": "Device Authorization",
          "Client ID": "Warden-Development-Frontend",
          "PKCE": true,
          "Redirect URL": "http://localhost:3000/auth/callback",
          "Auth URL": "https://identity.mallne.cloud/realms/DiCentra/protocol/openid-connect/auth",
          "Token URL": "https://identity.mallne.cloud/realms/DiCentra/protocol/openid-connect/token",
          "Device Auth URL": "https://identity.mallne.cloud/realms/DiCentra/protocol/openid-connect/auth/device",
          "Scope": "openid"
        }
      }
    }
  },
  "prod": {
    "server": "https://api.areaassist.mallne.cloud",
    "Security": {
      Auth: {
        "keycloak": {
          "Type": "OAuth2",
          "Grant Type": "Authorization Code",
          "Client ID": "Warden-Development-Frontend",
          "PKCE": true,
          "Redirect URL": "http://localhost:3000/auth/callback",
          "Auth URL": "https://identity.mallne.cloud/realms/DiCentra/protocol/openid-connect/auth",
          "Token URL": "https://identity.mallne.cloud/realms/DiCentra/protocol/openid-connect/token"
        }
      }
    }
  }
}