HOSTNAME=<%= hostname %>
DATA_URL=postgresql://localhost:5432
DATA_USER=postgres
DATA_PASSWORD=mysecretpassword
# Optional
AUTORELEASEVERSION
TLSENABLED
INFO
DESCRIPTION
DISCOVERY_EXCLUSIONS
CORS_ALL
CORS_HOSTS
DATA_SCHEMA
DATA_AUTOCREATEDELTA
DATA_MIGRATIONNAME
CATALYST_ENABLED
CATALYST_ANONYMOUS
CATALYST_SERVERNAME
CATALYST_TLSENABLED
CATALYST_TITLE
CATALYST_DESCRIPTION
# Option A: explicit exact hosts (comma-separated), e.g. for scoped service definitions.
CATALYST_ALLOWED_HOSTS=
# Option B: trust exact hosts from public definitions, whose publication is superadmin-only.
# This avoids listing every public provider host; scoped definitions still require the list above.
# HTTPS/public-IP/DNS-rebinding protections still apply. Enable only when superadmin-published
# public definitions are curated and trusted.
CATALYST_ALLOW_PUBLIC_SERVICE_HOSTS=true
# Leave the global transform default unchanged. AreaAssist web requests Catalyst via
# GET /services?transformationType=Catalyst; other targets use Auto/Native.
# PREFERRED_TRANSFORM=Native
# Set CORS_ALL=false and CORS_HOSTS to the AreaAssist web host[:port], no URL path.
# Example for a local web client: CORS_HOSTS=localhost:8081
SECURITY_ENABLED
SECURITY_ISSUER
SECURITY_SCOPES
SECURITY_CLIENTID
SECURITY_CLIENTSECRET
SECURITY_AREAASSIST_CLIENTID
SECURITY_AREAASSIST_CLIENTNAME
SECURITY_AREAASSIST_ACCOUNTCONSOLE
SECURITY_GROUPS_USER
SECURITY_GROUPS_SUPERADMIN
