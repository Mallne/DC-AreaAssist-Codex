{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "hostRules": [
    {
      "hostType": "maven",
      "matchHost": "https://registry.mallne.cloud/repository/DiCentraArtefacts/",
      "username": "{{ env.NEXUS_USERNAME }}",
      "password": "{{ secrets.NEXUS_PASSWORD }}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "cloud.mallne**"
      ],
      "registryUrls": [
        "https://registry.mallne.cloud/repository/DiCentraArtefacts/"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<build>\\d+)-build\\.(?<hash>\\w+))?$"
    },
    {
      "matchPackageNames": [
        "org.jetbrains.kotlinx:kotlinx-datetime"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<compatibility>.+))?$"
    },
    {
      "minimumReleaseAge": null,
      "description": "Allow internal DiCentra packages to bypass release age",
      "matchPackageNames": [
        "@dicentra/**",
        "cloud.mallne**"
      ]
    },
    {
      "description": "Automerge internal DiCentra packages after CI passes",
      "matchPackageNames": [
        "@dicentra/**",
        "cloud.mallne**"
      ],
      "automerge": true
    },
    {
      "description": "Automerge Docker and CI pipeline updates after CI passes",
      "matchManagers": [
        "dockerfile",
        "docker-compose",
        "github-actions",
        "gitlabci",
        "azure-pipelines",
        "circleci",
        "bitbucket-pipelines",
        "buildkite",
        "drone",
        "jenkins",
        "teamcity",
        "woodpecker"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "description": "Automerge patch and minor updates to external Maven dependencies after CI passes",
      "automerge": true,
      "matchDatasources": [
        "maven"
      ],
      "excludePackageNames": [
        "cloud.mallne**"
      ]
    },
    {
      "description": "Automerge patch and minor updates to external npm development dependencies after CI passes",
      "matchDatasources": [
        "npm"
      ],
      "excludePackageNames": [
        "@dicentra/*"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Do not automerge Gradle wrapper updates",
      "matchManagers": [
        "gradle-wrapper"
      ],
      "automerge": false
    },
    {
      "description": "Do not automerge Android Gradle Plugin updates",
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "com.android.library",
        "com.android.library:com.android.library.gradle.plugin",
        "com.android.kotlin.multiplatform.library",
        "com.android.kotlin.multiplatform.library:com.android.kotlin.multiplatform.library.gradle.plugin",
        "com.android.application",
        "com.android.application:com.android.application.gradle.plugin"
      ],
      "automerge": false
    }
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  },
  "minimumReleaseAge": "1 day"
}
