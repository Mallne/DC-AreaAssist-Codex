{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "packageRules": [
    {
      "description": "Group Docker Compose services",
      "matchManagers": [
        "docker-compose"
      ],
      "groupName": "Docker Compose services",
      "automerge": true
    },
    {
      "matchPackageNames": [
        "cloud.mallne**"
      ],
      "allowedVersions": "/^[0-9]+\\\\.[0-9]+\\\\.[0-9]+$/",
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<build>\\d+)-build\\.(?<hash>\\w+))?$"
    }
  ],
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ]
  }
}
